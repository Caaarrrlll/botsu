# Build output. Cargo.lock IS committed (binary crate; pins livekit/libwebrtc).
/target

# Secrets: any env file except the template.
.env
.env.*
*.env
!.env.example

# Local runtime data (SQLite database, yt-dlp cache, cookies).
/data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
cookies.txt

# Phase 0 spikes: build output and generated test audio.
/spikes/*/target/
/spikes/*.mp3

# Editors and OS. Shared VS Code run/debug setup is committed; personal settings aren't.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code per-user settings (shared .claude/settings.json is fine to commit).
.claude/settings.local.json

# Logs.
*.log
