# Copy to .env (local) or the server env file. NO quotes around values.
# Each platform is enabled by setting its token; set at least one.

# --- Discord ---
# Bot token: developer portal → your application → Bot → Reset Token.
# Requires Message Content Intent (same page, Privileged Gateway Intents).
DISCORD_TOKEN=
# Application ID (General Information page). Optional and not read by the bot: it logs ready-made
# invite links at startup. Kept for reference only.
DISCORD_APPLICATION_ID=

# --- Fluxer ---
# Bot token from your instance's Settings → Developer → your application.
FLUXER_TOKEN=
# Application ID (the part of the token before the "."). Optional and not read by the bot: it logs
# ready-made invite links at startup. Kept for reference only.
FLUXER_APPLICATION_ID=
# Your self-hosted Fluxer's web address (what you open in the browser). The bot finds the API
# URL itself from <address>/.well-known/fluxer. Leave unset for fluxer.app.
# FLUXER_URL=https://fluxer.example.com
# Only if discovery doesn't work: the API base including /v1. Overrides FLUXER_URL.
# FLUXER_API_URL=https://fluxer.example.com/api/v1

# --- YouTube (optional but recommended) ---
# YouTube Data API v3 key. Enables @handles in !tube add and posting live streams as "is live"
# (scheduled streams/premieres wait until they start). Free quota (10,000 units/day) is plenty.
# Get one: https://console.cloud.google.com → create a project → APIs & Services → Library →
# "YouTube Data API v3" → Enable → Credentials → Create credentials → API key (restrict it to
# the YouTube Data API v3). Without it, alerts still work with channel IDs/links.
YOUTUBE_API_KEY=

# --- Twitch (optional; enables !twitch alerts) ---
# Register an application at https://dev.twitch.tv/console/apps (OAuth redirect URL:
# http://localhost, category: Chat Bot), then "Manage" → copy the Client ID and create a
# Client Secret. Set both or neither.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Bot ---
# Bot owners: user IDs allowed to run !tube import, !twitch import and !tube shorts.
# Comma-separated; Discord and Fluxer IDs can be mixed.
# Don't know yours? Run "!tube import" and the bot replies with your ID.
BOTSU_OWNERS=

# Invite links in the log request Administrator instead of the specific permissions botsu uses.
# Easier setup (channel overrides stop mattering), but a leaked token then controls every
# server that accepted it. The bot's role still has to be dragged above the roles and members
# it manages. true or false (default).
# BOTSU_INVITE_ADMIN=false

# Where the SQLite database goes. Relative to where the bot starts; the Docker image uses /data.
# BOTSU_DATA_DIR=data

# Music: botsu downloads yt-dlp into <data dir>/bin on first start and updates it daily. Set this to
# use another yt-dlp instead (a system install on native Linux, for example); you then update it.
# YouTube also needs Deno 2.3+ on the PATH (the Docker image has it).
# BOTSU_YTDLP=/usr/local/bin/yt-dlp

# How often to check for new uploads / live streams, in seconds (minimums 60 and 30).
# YOUTUBE_POLL_SECONDS=300
# TWITCH_POLL_SECONDS=120

# Command prefix. Blank = $ (what Red used). Set something else, for example !, if another bot
# on the same servers already uses $. A server can also pick its own with setprefix (mods).
BOTSU_PREFIX=

# Which log levels to print, in any combination: ERROR, WARN, INFO, DEBUG, TRACE, or ALL
# (comma-separated, any case). Only those levels are printed: DEBUG,ERROR shows debug lines and
# errors, nothing else. Blank = ERROR,WARN,INFO. DEBUG shows every command run. Libraries
# (Discord, Fluxer, voice) only ever print their warnings and errors.
BOTSU_LOG=

# Expert override in tracing's filter syntax, for example info,songbird=debug. Wins over
# BOTSU_LOG set in the same place (a setting in the environment still beats this file).
# RUST_LOG=
