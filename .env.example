# Copy to .env (local) or the server env file. NO quotes around values.
# Each platform is enabled by setting its token; set at least one.

# --- Discord ---
# Bot token: developer portal → your application → Bot → Reset Token.
# Requires Message Content Intent (same page, Privileged Gateway Intents).
DISCORD_TOKEN=
# Application ID (General Information page). Not read by the bot; kept here for building the
# invite link: https://discord.com/oauth2/authorize?client_id=<id>&scope=bot&permissions=68608
DISCORD_APPLICATION_ID=

# --- Fluxer ---
# Bot token from your instance's Settings → Developer → your application.
FLUXER_TOKEN=
# Application ID (the part of the token before the "."). Not read by the bot; kept here for the
# invite link: <FLUXER_URL>/oauth2/authorize?client_id=<id>&scope=bot&permissions=68608
FLUXER_APPLICATION_ID=
# Your self-hosted Fluxer's web address (what you open in the browser). The bot finds the API
# URL itself from <address>/.well-known/fluxer. Leave unset for fluxer.app.
# FLUXER_URL=https://fluxer.example.com
# Only if discovery doesn't work: the API base including /v1. Overrides FLUXER_URL.
# FLUXER_API_URL=https://fluxer.example.com/api/v1

# --- YouTube (optional but recommended) ---
# YouTube Data API v3 key. Enables @handles in !tube add and posting live streams as "is live"
# (scheduled streams/premieres wait until they start). Free quota (10,000 units/day) is plenty.
# Get one: https://console.cloud.google.com → create a project → APIs & Services → Library →
# "YouTube Data API v3" → Enable → Credentials → Create credentials → API key (restrict it to
# the YouTube Data API v3). Without it, alerts still work with channel IDs/links.
YOUTUBE_API_KEY=

# --- Twitch (optional; enables !twitch alerts) ---
# Register an application at https://dev.twitch.tv/console/apps (OAuth redirect URL:
# http://localhost, category: Chat Bot), then "Manage" → copy the Client ID and create a
# Client Secret. Set both or neither.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Bot ---
# Bot owners: user IDs allowed to run !tube import / !twitch import and to remove or change
# anyone's alerts. Comma-separated; Discord and Fluxer IDs can be mixed.
# Don't know yours? Run "!tube import" and the bot replies with your ID.
BOTSU_OWNERS=

# Where the SQLite database goes. Relative to where the bot starts; the Docker image uses /data.
# BOTSU_DATA_DIR=data

# How often to check for new uploads / live streams, in seconds (minimums 60 and 30).
# YOUTUBE_POLL_SECONDS=300
# TWITCH_POLL_SECONDS=120

# Command prefix. Built-in default is $ (what Red used). Set to ! while Red still runs on
# the same servers so the two bots don't both answer; remove this line (or set $) at cutover.
BOTSU_PREFIX=!

# Log filter, tracing EnvFilter syntax. "botsu=debug" shows every command run.
RUST_LOG=info,botsu=debug
